# Скопируйте этот файл в .env и заполните. .env не попадает в git.

# --- Облачный проект Firebase ---
# Project settings -> General -> Your apps -> Web app -> SDK setup and configuration (Config)
# Эти значения не секретные (они всё равно есть в коде сайта), доступ защищают Security Rules.
FIREBASE_PROJECT_ID=
FIREBASE_API_KEY=
FIREBASE_AUTH_DOMAIN=
FIREBASE_APP_ID=

# Только для `npm run seed` в облако: путь к ключу сервисного аккаунта.
# СЕКРЕТ. Хранить вне папки проекта, никому не отправлять, в git не добавлять.
# Пример для Windows: C:\Users\Имя\keys\aitu-radar-admin.json
GOOGLE_APPLICATION_CREDENTIALS=

# Показывать кнопки демо-аккаунтов на странице входа (данные синтетические)
DEMO_ACCOUNTS=true

# true — работать с локальным эмулятором вместо облака (нужна Java). Пусто или false — облако.
USE_EMULATORS=false
